# Copy to .env.local and fill in. Never commit real values.

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AES-256-GCM key for eBag tokens: 32 random bytes, base64
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
EBAG_TOKEN_KEY=

# Public URL of the app (eBag OAuth redirect: $APP_BASE_URL/api/ebag/callback)
APP_BASE_URL=http://localhost:3000

# Optional — error tracking with Sentry (off when the DSN is empty). See README → Errors, logs and monitoring.
NEXT_PUBLIC_SENTRY_DSN=
# Build-time only (Vercel), to upload source maps:
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Optional — log level for the JSON logs: debug | info (default) | warn | error | silent
LOG_LEVEL=
