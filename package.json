{
  "name": "shopping-planner",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "ebag:login": "node scripts/ebag_login.mjs",
    "ebag:sync": "node --env-file-if-exists=.env.local scripts/sync.ts",
    "ebag:relink": "node --env-file-if-exists=.env.local scripts/sync.ts --relink --no-details",
    "usda:fill": "node scripts/fill_usda_macros.mjs",
    "recipes:build": "node scripts/build_recipes.mjs",
    "plan": "node scripts/plan.mjs",
    "review": "node scripts/review_server.mjs",
    "cart": "node scripts/send_to_cart.mjs",
    "db:push": "supabase db push",
    "test": "vitest run",
    "seed": "node --env-file-if-exists=.env.local scripts/seed.ts",
    "ebag:bootstrap": "node --env-file-if-exists=.env.local scripts/ebag_bootstrap.ts",
    "icons": "node scripts/make_icons.mjs",
    "images:fetch": "node scripts/fetch_recipe_images.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:coverage": "vitest run --coverage",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "prepare": "husky",
    "test:rls": "node --env-file-if-exists=.env.test.local node_modules/vitest/vitest.mjs run test/rls",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "highs": "^1.16.0",
    "next": "^15.5.29",
    "next-intl": "^4.16.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.29",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jsdom": "^31.0.1",
    "lint-staged": "^17.6.2",
    "postcss": "^8.5.33",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "^0.35.5",
    "supabase": "^3.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=22.18"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --max-warnings=0 --no-warn-ignored",
      "prettier --write"
    ],
    "*.{js,mjs,cjs,json,css,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
